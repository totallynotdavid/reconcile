# Signs the player cookie. Required in production: at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Moderator access to /api/admin/players (Authorization: Bearer <token>), at least 16 characters.
# Leave empty to switch moderation endpoints off.
ADMIN_TOKEN=

# Where the SQLite file lives. Needs a persistent disk. Default: ./data/reconcile.db
DB_PATH=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For and X-Forwarded-Host.
# Without it the per-address join limit is off (only the site-wide one applies) and the Origin
# check uses the Host header.
TRUST_PROXY=
